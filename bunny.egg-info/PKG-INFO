# 2. 测试视觉塔初始化
print("👁️ 正在初始化视觉塔...")
vision_tower = model.get_model().get_vision_tower()
vision_tower.load_model() # 看看会不会报路径错误

print("✅ 恭喜！模型代码完全自洽，可以独立运行。")
